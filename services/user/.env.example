APP_TIMEZONE=europe/kyiv

APP_NAME=user-service
APP_ENV=local
APP_ID_KEY=x-request-id

SERVICE_NAME=user

GRPC_PORT=5000
GRPC_REFLECTION=true
GRPC_TIMEOUT=5s
GRPC_MAX_RECV_MSG_SIZE=4194304
GRPC_MAX_SEND_MSG_SIZE=4194304
GRPC_HEALTH_INTERVAL=10s
GRPC_KEEPALIVE_MAX_CONNECTION_IDLE=5m#Соединение, по которому 5 минут не было ни одного запроса, сервер закрывает.
GRPC_KEEPALIVE_MAX_CONNECTION_AGE=30m#Максимальный срок жизни соединения, даже если оно активно.
GRPC_KEEPALIVE_MAX_CONNECTION_AGE_GRACE=30s#Сколько времени после MaxConnectionAge даётся на дозавершение текущих запросов.
GRPC_KEEPALIVE_TIME=1m#Если от клиента 1 минуту нет никакой активности, сервер сам шлёт ему ping: «ты жив?».
GRPC_KEEPALIVE_TIMEOUT=20s#Сколько ждать ответа на этот ping. Не ответил за 20 секунд, соединение считается мёртвым и закрывается.
GRPC_KEEPALIVE_MIN_TIME=10s#Клиент не должен пинговать чаще, чем раз в 10 секунд. Если пингует чаще, сервер закрывает соединение с ошибкой too_many_pings
GRPC_KEEPALIVE_PERMIT_WITHOUT_STREAM=true#Можно ли клиенту пинговать, когда нет ни одного активного запроса. При false такой пинг считается нарушением и приводит к закрытию. При true клиент может держать «прогретое» соединение.


LOGGER_LEVEL=DEBUG
LOGGER_FORMAT=CONSOLE
LOGGER_FOLDER=out/log

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENTID=user-service-client
KAFKA_DIAL_TIMEOUT=10s
KAFKA_TLS=false
# KAFKA_SASL_USERNAME=my_user
# KAFKA_SASL_PASSWORD=my_password

KAFKA_WRITER_WRITE_TIMEOUT=1s
KAFKA_WRITER_BATCH_TIMEOUT=0s
KAFKA_WRITER_BATCH_SIZE=1
KAFKA_WRITER_ALLOW_TOPIC_AUTO_CREATION=true
KAFKA_WRITER_DLT_SUFFIX=.DLT
KAFKA_WRITER_TOPICS=user.created,user.updated,user.deleted

KAFKA_READER_TOPICS=user.created,user.updated,user.deleted
KAFKA_READER_GROUP_ID=user-service-group
KAFKA_READER_START_FROM_LATEST=false
KAFKA_READER_MIN_BYTES=10240
KAFKA_READER_MAX_BYTES=1048576
KAFKA_READER_MAX_WAIT=1s

POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_SSLMODE=
POSTGRES_CONN_TIMEOUT=
POSTGRES_OP_TIMEOUT=
POSTGRES_TX_TIMEOUT=

MIGRATION_FOLDER=
MIGRATION_CONTAINER=
POSTGRES_CONTAINER=
POSTGRES_FOLDER=

PORT_FORWARDER_CONTAINER=port-forwarder